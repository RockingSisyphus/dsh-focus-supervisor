{
  "schemaVersion": 1,
  "engine": "dsh",
  "platforms": [
    "linux",
    "windows"
  ],
  "verification": "product",
  "group": "manual",
  "features": [
    "persistence",
    "heartbeat"
  ],
  "timeout": 300,
  "present_user": true,
  "id": "active-reboot-resume",
  "title": "跨重启恢复：原任务交付新心跳并完成模型工具调用",
  "steps": [
    {
      "id": "load",
      "op": "session.load"
    },
    {
      "id": "heartbeat",
      "op": "heartbeat.enable"
    },
    {
      "id": "same-task",
      "op": "state.wait",
      "task_id": {
        "$ref": "task.value.id"
      },
      "status": "active",
      "bind": "restored"
    },
    {
      "id": "same-session",
      "op": "assert",
      "actual": {
        "$ref": "restored.session_id"
      },
      "operator": "equals",
      "expected": {
        "$ref": "task.value.session_id"
      }
    },
    {
      "id": "new-report",
      "op": "report.wait",
      "task_id": {
        "$ref": "task.value.id"
      },
      "exclude": [
        {
          "$ref": "before_report.id"
        }
      ],
      "bind": "after_report",
      "timeout": 120,
      "created_after": {
        "$ref": "scenario_started_at"
      },
      "phase": "monitor",
      "sampled_after": {
        "$ref": "scenario_started_at"
      }
    },
    {
      "id": "new-real-sampling",
      "op": "assert",
      "actual": {
        "$ref": "after_report.raw.real_end"
      },
      "operator": "gt",
      "expected": {
        "$ref": "scenario_started_at"
      }
    },
    {
      "id": "desktop-restored",
      "op": "assert",
      "actual": {
        "$ref": "after_report.raw.current_desktop_available"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "actual-model-input",
      "op": "model.notice",
      "text": {
        "$ref": "after_report.id"
      }
    },
    {
      "id": "new-report-id",
      "op": "assert",
      "actual": {
        "$ref": "after_report.id"
      },
      "operator": "not_equals",
      "expected": {
        "$ref": "before_report.id"
      }
    },
    {
      "id": "actual-tool-return",
      "op": "model.tool_result",
      "tool": "focus_observe",
      "arguments": {
        "report_id": {
          "$ref": "after_report.id"
        }
      }
    }
  ]
}
