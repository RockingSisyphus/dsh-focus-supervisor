{
  "schemaVersion": 1,
  "id": "compact-model-input",
  "title": "真实 DSH 动态任务上下文、紧凑回执与活动分页",
  "engine": "dsh",
  "features": [
    "heartbeat",
    "desktop-gnome",
    "evidence",
    "native-tools",
    "actions",
    "cleanup"
  ],
  "variables": {
    "contract": {
      "agreement": "读懂专用测试窗口里的论文文字。",
      "task_prompt": "TASK_EXTRA_314159",
      "project_dir": {
        "$ref": "project"
      },
      "start_at": {
        "$iso_after": 180
      },
      "end_at": {
        "$iso_after": 900
      },
      "allow_early_finish": true,
      "deadline_policy": "discuss"
    }
  },
  "steps": [
    {
      "id": "custom-prompts",
      "op": "ui.settings",
      "values": {
        "instructions": "GLOBAL_INSTRUCTIONS_271828",
        "heartbeat_prompt": "GLOBAL_HEARTBEAT_161803"
      },
      "save": true
    },
    {
      "id": "close",
      "op": "ui.close"
    },
    {
      "id": "choose-workspace",
      "op": "ui.workspace"
    },
    {
      "id": "heartbeat-model",
      "op": "heartbeat.enable"
    },
    {
      "id": "bind-dsh-browser",
      "op": "fixture.page",
      "entity": "dsh-browser"
    },
    {
      "id": "browser-before",
      "op": "desktop.snapshot",
      "entity": "dsh-browser",
      "bind": "before_browser"
    },
    {
      "id": "plan-active",
      "op": "model.call",
      "user": "测试：plan-active",
      "tool": "focus_plan",
      "arguments": {
        "$merge": [
          {
            "$ref": "contract"
          },
          {
            "start_at": {
              "$iso_after": -1
            },
            "check_interval_seconds": 6
          }
        ]
      },
      "bind": "task"
    },
    {
      "id": "browser-fixture",
      "op": "fixture.browser",
      "entity": "article",
      "separate_instance": true,
      "url": {
        "$concat": [
          {
            "$ref": "fixture_url"
          },
          "/observer.html"
        ]
      }
    },
    {
      "id": "ordinary-restart",
      "op": "fixture.browser_restart",
      "entity": "article",
      "remote_debugging": false,
      "bind": "ordinary"
    },
    {
      "id": "no-debug-port",
      "op": "assert",
      "actual": {
        "$ref": "ordinary.remote_debugging"
      },
      "operator": "equals",
      "expected": false
    },
    {
      "id": "no-forced-accessibility-flag",
      "op": "assert",
      "actual": {
        "$ref": "ordinary.force_renderer_accessibility"
      },
      "operator": "equals",
      "expected": false
    },
    {
      "id": "browser-layout",
      "op": "fixture.window",
      "entity": "article",
      "action": "layout",
      "rect": [
        0,
        32,
        640,
        700
      ]
    },
    {
      "id": "create-native-fixture",
      "op": "fixture.app",
      "entity": "legacy-app",
      "windows": [
        {
          "title": "FocusTest GTK same title",
          "rect": [
            30,
            40,
            440,
            320
          ],
          "controls": [
            {
              "type": "label",
              "text": "ALPHA_REAL_ATSPI_314159\n真实界面文字：正在核验通用无障碍采集。"
            },
            {
              "type": "edit",
              "text": "VISIBLE_EDITED_VALUE_0"
            },
            {
              "type": "password",
              "text": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
            }
          ],
          "id": "legacy-0"
        },
        {
          "title": "FocusTest GTK same title",
          "rect": [
            510,
            40,
            440,
            320
          ],
          "controls": [
            {
              "type": "label",
              "text": "BETA_REAL_ATSPI_271828\n真实界面文字：正在核验通用无障碍采集。"
            },
            {
              "type": "edit",
              "text": "VISIBLE_EDITED_VALUE_1"
            },
            {
              "type": "password",
              "text": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
            }
          ],
          "id": "legacy-1"
        }
      ]
    },
    {
      "id": "show-left-native",
      "op": "fixture.interact",
      "entity": "legacy-0",
      "action": "focus"
    },
    {
      "id": "show-right-native",
      "op": "fixture.interact",
      "entity": "legacy-1",
      "action": "focus"
    },
    {
      "id": "native-identities",
      "op": "native.accessibility_inventory",
      "bind": "nativeIdentities"
    },
    {
      "id": "observe-focus",
      "op": "fixture.watch_input",
      "entity": "legacy-1",
      "seconds": 30,
      "chunks": [],
      "bind": "focus_watch"
    },
    {
      "id": "browser-after",
      "op": "desktop.snapshot",
      "entity": "dsh-browser",
      "bind": "after_browser"
    },
    {
      "id": "actual-browser-windows",
      "op": "fixture.browser_inventory",
      "bind": "browser_inventory"
    },
    {
      "id": "no-extra-browser-window",
      "op": "assert",
      "actual": {
        "$ref": "browser_inventory.window_count"
      },
      "operator": "equals",
      "expected": 1
    },
    {
      "id": "focus-retained",
      "op": "assert",
      "actual": {
        "$ref": "focus_watch.focus_retained"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "latest-report",
      "op": "report.wait",
      "task_id": {
        "$ref": "task.value.id"
      },
      "phase": "monitor",
      "minimum_samples": 2,
      "bind": "semantic_report"
    },
    {
      "id": "read-material",
      "op": "evidence.inspect",
      "report_id": {
        "$ref": "semantic_report.id"
      },
      "bind": "material"
    },
    {
      "id": "semantic-2",
      "op": "assert",
      "actual": {
        "$ref": "material.browser_semantic_text"
      },
      "operator": "contains",
      "expected": "SEMANTIC_HEADING_271828"
    },
    {
      "id": "semantic-3",
      "op": "assert",
      "actual": {
        "$ref": "material.browser_semantic_text"
      },
      "operator": "contains",
      "expected": "SEMANTIC_BODY_314159"
    },
    {
      "id": "semantic-4",
      "op": "assert",
      "actual": {
        "$ref": "material.browser_semantic_text"
      },
      "operator": "contains",
      "expected": "SEMANTIC_INPUT_161803"
    },
    {
      "id": "semantic-5",
      "op": "assert",
      "actual": {
        "$ref": "material.browser_semantic_text"
      },
      "operator": "contains",
      "expected": "SEMANTIC_VALUE_57721"
    },
    {
      "id": "semantic-6",
      "op": "assert",
      "actual": {
        "$ref": "material.browser_semantic_text"
      },
      "operator": "contains",
      "expected": "[checked]"
    },
    {
      "id": "password-excluded",
      "op": "assert",
      "actual": {
        "$ref": "material.browser_semantic_text"
      },
      "operator": "not_contains",
      "expected": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
    },
    {
      "id": "dsh-read-semantic-file",
      "op": "model.call",
      "user": "请读取本轮正式浏览器语义证据。",
      "tool": "read",
      "arguments": {
        "file_path": {
          "$concat": [
            {
              "$ref": "material.folder"
            },
            "/browser-snapshots.json"
          ]
        }
      },
      "bind": "dsh_semantic"
    },
    {
      "id": "dsh-received-semantic-body",
      "op": "assert",
      "actual": {
        "$ref": "dsh_semantic.raw"
      },
      "operator": "contains",
      "expected": "SEMANTIC_BODY_314159"
    },
    {
      "id": "heartbeat-messages",
      "op": "model.messages",
      "contains": "[大肥鱼心跳：",
      "role": "user",
      "bind": "heartbeat"
    },
    {
      "id": "no-repeated-heartbeat-custom",
      "op": "assert",
      "actual": {
        "$ref": "heartbeat.text"
      },
      "operator": "not_contains",
      "expected": "GLOBAL_HEARTBEAT_161803"
    },
    {
      "id": "no-repeated-task-custom",
      "op": "assert",
      "actual": {
        "$ref": "heartbeat.text"
      },
      "operator": "not_contains",
      "expected": "TASK_EXTRA_314159"
    },
    {
      "id": "task-context",
      "op": "model.messages",
      "contains": "[大肥鱼当前任务约定]",
      "bind": "context"
    },
    {
      "id": "custom-task-retained",
      "op": "assert",
      "actual": {
        "$ref": "context.text"
      },
      "operator": "contains",
      "expected": "TASK_EXTRA_314159"
    },
    {
      "id": "custom-heartbeat-retained",
      "op": "assert",
      "actual": {
        "$ref": "context.text"
      },
      "operator": "contains",
      "expected": "GLOBAL_HEARTBEAT_161803"
    },
    {
      "id": "compact-status",
      "op": "model.call",
      "user": "读取紧凑状态",
      "tool": "focus_status",
      "arguments": {},
      "bind": "compact"
    },
    {
      "id": "compact-no-settings",
      "op": "assert",
      "actual": {
        "$ref": "compact.value.settings"
      },
      "operator": "exists",
      "expected": false
    },
    {
      "id": "full-status",
      "op": "model.call",
      "user": "读取完整状态",
      "tool": "focus_status",
      "arguments": {
        "detail": "full"
      },
      "bind": "full",
      "result_fields": [
        "settings"
      ]
    },
    {
      "id": "full-settings-retained",
      "op": "assert",
      "actual": {
        "$ref": "full.value.settings"
      },
      "operator": "exists",
      "expected": true
    },
    {
      "id": "read-activity",
      "op": "model.paginate",
      "user": "读取完整活动变化",
      "tool": "focus_report",
      "arguments": {
        "report_id": {
          "$ref": "semantic_report.id"
        },
        "operation": "read_activity_changes"
      },
      "bind": "changes"
    },
    {
      "id": "activity-present",
      "op": "assert",
      "actual": {
        "$ref": "changes.items"
      },
      "operator": "contains",
      "expected": "focus_seconds"
    },
    {
      "id": "observed-focus-target",
      "op": "fixture.observe",
      "entity": "legacy-1",
      "bind": "focus_identity"
    },
    {
      "id": "select-focus-activity",
      "op": "data.select",
      "rows": {
        "$ref": "changes.items"
      },
      "where": {
        "window_id": {
          "$ref": "focus_identity.window_id"
        }
      },
      "bind": "focus_activity"
    },
    {
      "id": "one-focus-activity-row",
      "op": "assert",
      "actual": {
        "$ref": "focus_activity"
      },
      "operator": "count",
      "expected": 1
    },
    {
      "id": "observed-focus-duration",
      "op": "assert",
      "actual": {
        "$ref": "focus_activity.0.focus_seconds"
      },
      "operator": "gt",
      "expected": 0
    },
    {
      "id": "continuous-focus-streak",
      "op": "assert",
      "actual": {
        "$ref": "focus_activity.0.longest_focus_seconds"
      },
      "operator": "equals",
      "expected": {
        "$ref": "focus_activity.0.focus_seconds"
      }
    },
    {
      "id": "focus-was-visible",
      "op": "assert",
      "actual": {
        "$ref": "focus_activity.0.visible_seconds"
      },
      "operator": "equals",
      "expected": {
        "$ref": "focus_activity.0.focus_seconds"
      }
    },
    {
      "id": "finish",
      "op": "model.call",
      "user": "测试：finish",
      "tool": "focus_finish",
      "arguments": {
        "task_id": {
          "$ref": "task.value.id"
        },
        "verdict": "completed",
        "reason": "固定回复只验证软件验收流程。"
      },
      "bind": "result"
    }
  ],
  "group": "extended",
  "platforms": [
    "linux",
    "windows"
  ],
  "verification": "product",
  "note": "独立浏览器 profile 不加载任何采集扩展；重启后无调试端口，通过真实 DSH 验收可见未聚焦正文。",
  "present_user": true,
  "timeout": 360,
  "browser_skill": false
}
