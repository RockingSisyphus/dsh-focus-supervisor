{
  "schemaVersion": 1,
  "id": "native-tab-close-update-windows",
  "title": "Windows 正式更新并验证普通 Edge 标签关闭与显式进程升级",
  "engine": "command",
  "execution": "vm-orchestration",
  "verification": "product",
  "group": "manual",
  "platforms": [
    "windows"
  ],
  "installation": "existing-system",
  "features": [
    "actions",
    "tool.focus_act.force_close.browser_tab"
  ],
  "timeout": 1800,
  "steps": [
    {
      "id": "installer",
      "op": "vm.command.start",
      "argv": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "deploy/install-windows.ps1"
      ]
    },
    {
      "id": "authorize",
      "op": "vm.authorize"
    },
    {
      "id": "installed",
      "op": "vm.command.wait",
      "command": "installer",
      "timeout": 1200,
      "bind": "installer"
    },
    {
      "id": "installer-exit",
      "op": "assert",
      "actual": {
        "$ref": "installer.code"
      },
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "use-installed-plugin",
      "op": "case.run",
      "cases": [
        "force-close-browser-default",
        "force-close-browser-unload-warning",
        "force-close-browser-no-tab-identity"
      ],
      "bind": "use"
    },
    {
      "id": "normal-use-passed",
      "op": "assert",
      "actual": {
        "$ref": "use.status"
      },
      "operator": "equals",
      "expected": "passed"
    }
  ]
}
