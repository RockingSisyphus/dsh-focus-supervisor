{
  "schemaVersion": 1,
  "id": "debug-evidence-retention-update-windows",
  "title": "Windows 正式更新后验证调试证据保留",
  "engine": "command",
  "execution": "vm-orchestration",
  "verification": "product",
  "group": "extended",
  "platforms": ["windows"],
  "installation": "existing-system",
  "features": ["settings-ui", "evidence", "cleanup"],
  "timeout": 1800,
  "steps": [
    {"id": "installer", "op": "vm.command.start",
     "argv": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
              "-File", "deploy/install-windows.ps1"]},
    {"id": "authorize", "op": "vm.authorize"},
    {"id": "installed", "op": "vm.command.wait", "command": "installer",
     "timeout": 1200, "bind": "installer"},
    {"id": "installer-exit", "op": "assert", "actual": {"$ref": "installer.code"},
     "operator": "equals", "expected": 0},
    {"id": "product", "op": "case.run", "cases": ["debug-evidence-retention"], "bind": "use"},
    {"id": "product-passed", "op": "assert", "actual": {"$ref": "use.status"},
     "operator": "equals", "expected": "passed"}
  ]
}
