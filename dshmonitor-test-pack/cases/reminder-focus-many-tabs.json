      "html": "<title>Focus load tab 16</title><input>"
    },
    {
      "id": "extra-tab-17",
      "op": "fixture.browser",
      "entity": "extra-17",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 17</title><input>"
    },
    {
      "id": "extra-tab-18",
      "op": "fixture.browser",
      "entity": "extra-18",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 18</title><input>"
    },
    {
      "id": "extra-tab-19",
