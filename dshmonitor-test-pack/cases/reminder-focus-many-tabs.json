      "entity": "extra-13",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 13</title><input>"
    },
    {
      "id": "extra-tab-14",
      "op": "fixture.browser",
      "entity": "extra-14",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 14</title><input>"
    },
    {
      "id": "extra-tab-15",
