    },
    {
      "id": "extra-tab-23",
      "op": "fixture.browser",
      "entity": "extra-23",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 23</title><input>"
    },
    {
      "id": "extra-tab-24",
      "op": "fixture.browser",
      "entity": "extra-24",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 24</title><input>"
    },
    {
      "id": "extra-tab-25",
      "op": "fixture.browser",
      "entity": "extra-25",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 25</title><input>"
    },
    {
      "id": "extra-tab-26",
      "op": "fixture.browser",
      "entity": "extra-26",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 26</title><input>"
    },
    {
      "id": "extra-tab-27",
      "op": "fixture.browser",
      "entity": "extra-27",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 27</title><input>"
    },
    {
      "id": "tab-count",
      "op": "fixture.browser_state",
      "entity": "dsh",
      "bind": "tabs"
    },
    {
      "id": "thirty-tabs",
      "op": "assert",
      "actual": {
        "$ref": "tabs.count"
      },
      "operator": "equals",
      "expected": 30
    },
    {
      "id": "other-window",
      "op": "fixture.browser",
      "entity": "other",
      "html": "<title>Other browser window</title><input>"
    },
    {
      "id": "minimize-dsh",
      "op": "fixture.window",
      "entity": "dsh",
      "action": "minimize"
    },
    {
      "id": "minimized-tab-selection",
      "op": "fixture.browser_state",
      "entity": "dsh",
      "bind": "minimized_tabs"
    },
    {
      "id": "before",
      "op": "fixture.observe",
      "entity": "dsh",
      "bind": "before"
    },
    {
      "id": "pre-minimized",
      "op": "assert",
      "actual": {
        "$ref": "before.window.minimized"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "pre-background",
      "op": "assert",
      "actual": {
        "$ref": "before.visibility"
      },
      "operator": "equals",
      "expected": "hidden"
    },
    {
      "id": "tabs-before",
      "op": "fixture.browser_inventory",
      "bind": "tabs_before"
    },
    {
      "id": "click-reminder",
      "op": "desktop.popup_click",
      "wait_closed": false
    },
    {
      "id": "request-finished",
      "op": "ui.wait_focus_result",
      "timeout": 10,
      "bind": "completion"
    },
    {
      "id": "completion-within-budget",
      "op": "assert",
      "actual": {
        "$ref": "completion.elapsed_seconds"
      },
      "operator": "lt",
      "expected": 10,
      "continue_on_failure": true
    },
    {
      "id": "request-succeeded",
      "op": "assert",
      "actual": {
        "$ref": "completion.request.status"
      },
      "operator": "equals",
      "expected": "completed",
      "continue_on_failure": true
    },
    {
      "id": "native-state",
      "op": "fixture.wait",
      "entity": "dsh",
      "bind": "native",
      "expected": {
        "window.minimized": false,
        "window.focused": true,
        "visibility": "visible"
      },
      "timeout": 10
    },
    {
      "id": "focus-diagnostics",
      "op": "ui.focus_diagnostics"
    },
    {
      "id": "actually-restored",
      "op": "assert",
      "actual": {
        "$ref": "native.window.minimized"
      },
      "operator": "equals",
      "expected": false,
      "continue_on_failure": true
    },
    {
      "id": "actually-focused",
      "op": "assert",
      "actual": {
        "$ref": "native.window.focused"
      },
      "operator": "equals",
      "expected": true,
      "continue_on_failure": true
    },
    {
      "id": "right-session",
      "op": "ui.wait_focused_session",
      "session_id": {
        "$ref": "result.value.session_id"
      }
    },
    {
      "id": "selected-tab",
      "op": "assert",
      "actual": {
        "$ref": "native.visibility"
      },
      "operator": "equals",
      "expected": "visible"
    },
    {
      "id": "tabs-after",
      "op": "fixture.browser_inventory",
      "bind": "tabs_after"
    },
    {
      "id": "no-duplicate-tab",
      "op": "assert",
      "actual": {
        "$ref": "tabs_after.total"
      },
      "operator": "equals",
      "expected": {
        "$ref": "tabs_before.total"
      }
    },
    {
      "id": "focus-editor",
      "op": "fixture.interact",
      "entity": "editor",
      "action": "focus"
    },
    {
      "id": "no-focus-steal",
      "op": "fixture.watch_input",
      "entity": "editor",
      "seconds": 30,
      "chunks": [
        "alpha",
        "beta",
        "gamma"
      ],
      "bind": "watch"
    },
    {
      "id": "focus-retained",
      "op": "assert",
      "actual": {
        "$ref": "watch.focus_retained"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "typed-text",
      "op": "assert",
      "actual": {
        "$ref": "watch.input_text"
      },
      "operator": "contains",
      "expected": "alphabetagamma"
    },
    {
      "id": "return-user",
      "op": "fixture.window",
      "entity": "dsh",
      "action": "activate"
    },
    {
      "id": "responding",
      "op": "model.reply",
      "user": "恢复后界面响应验证",
      "text": "消息通道仍正常。"
    }
  ],
  "visible_browser": true,
  "real_tab_visibility": true,
  "group": "extended",
  "platforms": [
    "linux",
    "windows"
  ],
  "verification": "product"
}
