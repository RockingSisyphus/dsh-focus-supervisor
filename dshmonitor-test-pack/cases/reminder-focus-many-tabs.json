      "entity": "extra-11",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 11</title><input>"
    },
    {
      "id": "extra-tab-12",
      "op": "fixture.browser",
      "entity": "extra-12",
      "new_window": false,
