      "entity": "extra-19",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 19</title><input>"
    },
    {
      "id": "extra-tab-20",
      "op": "fixture.browser",
      "entity": "extra-20",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 20</title><input>"
    },
    {
      "id": "extra-tab-21",
      "op": "fixture.browser",
      "entity": "extra-21",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 21</title><input>"
    },
    {
