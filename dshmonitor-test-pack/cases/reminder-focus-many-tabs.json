{
  "schemaVersion": 1,
  "id": "reminder-focus-many-tabs",
  "title": "30 个真实标签中的后台 DSH 唤回",
  "engine": "dsh",
  "features": [
    "live-reminder-delivery",
    "ui-navigation"
  ],
  "preview": true,
  "present_user": false,
  "timeout": 600,
  "live_desktop": true,
  "note": "生产唤回动作后先独立观察原生窗口，测试器不恢复或反复激活 DSH。",
  "variables": {
    "contract": {
      "agreement": "读懂专用测试窗口里的论文文字。",
      "task_prompt": "脚本模拟：结合真实采集核对任务，不要求提交文件。",
      "project_dir": {
        "$ref": "project"
      },
      "start_at": {
        "$iso_after": 86400
      },
      "end_at": {
        "$iso_after": 90000
      },
      "allow_early_finish": true,
      "check_interval_seconds": 6
    }
  },
  "steps": [
    {
      "id": "workspace",
      "op": "ui.workspace"
    },
    {
      "id": "plan",
      "op": "model.call",
      "user": "我想预约阅读事务论文，允许提前完成；遇到问题可以商量延期。",
      "tool": "focus_plan",
      "arguments": {
        "$ref": "contract"
      },
      "bind": "task"
    },
    {
      "id": "scheduled",
      "op": "assert",
      "actual": {
        "$ref": "task.value.status"
      },
      "operator": "equals",
      "expected": "scheduled"
    },
    {
      "id": "reminder",
      "op": "model.call",
      "user": "请提醒我回到监工聊天。switch-existing-tab",
      "tool": "focus_act",
      "arguments": {
        "task_id": {
          "$ref": "task.value.id"
        },
        "action": "remind",
        "image": "start",
        "message": "任务已建好，点下面的按钮回到监工会话。"
      },
      "bind": "result"
    },
    {
      "id": "reminder-delivered",
      "op": "assert",
      "actual": {
        "$ref": "result.value.delivery.popup"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "session-b",
      "op": "ui.new_session"
    },
    {
      "id": "message-b",
      "op": "model.reply",
      "user": "焦点回归会话 B",
      "text": "这是另一个真实会话。"
    },
    {
      "id": "bind-dsh",
      "op": "fixture.page",
      "entity": "dsh"
    },
    {
      "id": "editor",
      "op": "fixture.app",
      "entity": "editor-app",
      "windows": [
        {
          "id": "editor",
          "title": "DSH focus regression input",
          "controls": [
            {
              "type": "edit",
              "text": ""
            }
          ],
          "rect": [
            80,
            120,
            500,
            350
          ]
        }
      ]
    },
    {
      "id": "cover-tab",
      "op": "fixture.browser",
      "entity": "cover",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Background cover</title><input>"
    },
    {
      "id": "extra-tab-0",
      "op": "fixture.browser",
      "entity": "extra-0",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 0</title><input>"
    },
    {
      "id": "extra-tab-1",
      "op": "fixture.browser",
      "entity": "extra-1",
      "new_window": false,
      "window": "dsh",
      "html": "<title>Focus load tab 1</title><input>"
    },
    {
      "id": "extra-tab-2",
      "op": "fixture.browser",
      "entity": "extra-2",
      "new_window": false,
