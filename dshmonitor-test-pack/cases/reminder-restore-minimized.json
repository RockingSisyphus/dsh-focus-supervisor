{
  "schemaVersion": 1,
  "id": "reminder-restore-minimized",
  "title": "真实提醒恢复最小化的 DSH 浏览器窗口并进入对应会话",
  "engine": "dsh",
  "features": [
    "live-reminder-delivery",
    "ui-navigation"
  ],
  "preview": true,
  "present_user": true,
  "timeout": 360,
  "live_desktop": true,
  "note": "生产唤回动作后先独立观察原生窗口，测试器不恢复或反复激活 DSH。",
  "variables": {
    "contract": {
      "agreement": "读懂专用测试窗口里的论文文字。",
      "task_prompt": "脚本模拟：结合真实采集核对任务，不要求提交文件。",
      "project_dir": {
        "$ref": "project"
      },
      "start_at": {
        "$iso_after": 86400
      },
      "end_at": {
        "$iso_after": 90000
      },
      "allow_early_finish": true,
      "deadline_policy": "discuss",
      "check_interval_seconds": 6
    }
  },
  "steps": [
    {
      "id": "workspace",
      "op": "ui.workspace"
    },
    {
      "id": "plan",
      "op": "model.call",
      "user": "我想预约阅读事务论文，允许提前完成；遇到问题可以商量延期。",
      "tool": "focus_plan",
      "arguments": {
        "$ref": "contract"
      },
      "bind": "task"
    },
    {
      "id": "scheduled",
      "op": "assert",
      "actual": {
        "$ref": "task.value.status"
      },
      "operator": "equals",
      "expected": "scheduled"
    },
    {
      "id": "reminder",
      "op": "model.call",
      "user": "请提醒我回到监工聊天。switch-existing-tab",
      "tool": "focus_act",
      "arguments": {
        "task_id": {
          "$ref": "task.value.id"
        },
        "action": "remind",
        "image": "start",
        "message": "任务已建好，点下面的按钮回到监工会话。"
      },
      "bind": "result"
    },
    {
      "id": "reminder-delivered",
      "op": "assert",
      "actual": {
        "$ref": "result.value.delivery.popup"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "bind-dsh",
      "op": "fixture.page",
      "entity": "dsh"
    },
    {
      "id": "minimize-dsh",
      "op": "fixture.window",
      "entity": "dsh",
      "action": "minimize"
    },
    {
      "id": "click-reminder",
      "op": "desktop.popup_click"
    },
    {
      "id": "native-state",
      "op": "fixture.wait",
      "entity": "dsh",
      "bind": "native",
      "expected": {
        "window.minimized": false,
        "window.focused": true
      },
      "timeout": 10
    },
    {
      "id": "actually-restored",
      "op": "assert",
      "actual": {
        "$ref": "native.window.minimized"
      },
      "operator": "equals",
      "expected": false,
      "continue_on_failure": true
    },
    {
      "id": "actually-focused",
      "op": "assert",
      "actual": {
        "$ref": "native.window.focused"
      },
      "operator": "equals",
      "expected": true,
      "continue_on_failure": true
    },
    {
      "id": "right-session",
      "op": "ui.wait_focused_session",
      "session_id": {
        "$ref": "result.value.session_id"
      }
    }
  ],
  "visible_browser": true,
  "real_tab_visibility": true,
  "group": "extended",
  "platforms": [
    "linux",
    "windows"
  ],
  "verification": "product"
}
