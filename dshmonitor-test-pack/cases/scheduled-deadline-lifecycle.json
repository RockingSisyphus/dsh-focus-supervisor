{
  "schemaVersion": 1,
  "id": "scheduled-deadline-lifecycle",
  "title": "真实预约、提前验收等待与到时停止监督",
  "engine": "dsh",
  "platforms": [
    "linux",
    "windows"
  ],
  "group": "extended",
  "verification": "product",
  "verification_layer": "dsh",
  "features": [
    "scheduling",
    "deadlines",
    "cleanup"
  ],
  "timeout": 480,
  "steps": [
    {
      "id": "workspace",
      "op": "ui.workspace"
    },
    {
      "id": "heartbeat",
      "op": "heartbeat.enable"
    },
    {
      "id": "scheduled-plan",
      "op": "model.call",
      "user": "真实生命周期验证：scheduled-plan",
      "tool": "focus_plan",
      "arguments": {
        "agreement": "测试真实预约及截止状态",
        "task_prompt": "仅观察本测试任务，不处理任何日常窗口。",
        "project_dir": {
          "$ref": "project"
        },
        "start_at": {
          "$iso_after": 30
        },
        "end_at": {
          "$iso_after": 100
        },
        "allow_early_finish": false,
        "check_interval_seconds": 10
      },
      "bind": "scheduled"
    },
    {
      "id": "initially-scheduled",
      "op": "state.wait",
      "task_id": {
        "$ref": "scheduled.value.id"
      },
      "status": "scheduled",
      "timeout": 10
    },
    {
      "id": "becomes-active",
      "op": "state.wait",
      "task_id": {
        "$ref": "scheduled.value.id"
      },
      "status": "active",
      "timeout": 60
    },
    {
      "id": "verified-before-deadline",
      "op": "model.call",
      "user": "真实生命周期验证：verified-before-deadline",
      "tool": "focus_finish",
      "arguments": {
        "task_id": {
          "$ref": "scheduled.value.id"
        },
        "verdict": "completed",
        "reason": "真实提前验收，但约定不提前退出"
      }
    },
    {
      "id": "waits-for-deadline",
      "op": "state.wait",
      "task_id": {
        "$ref": "scheduled.value.id"
      },
      "status": "verified_waiting",
      "timeout": 10
    },
    {
      "id": "completes-at-deadline",
      "op": "state.wait",
      "task_id": {
        "$ref": "scheduled.value.id"
      },
      "status": "completed",
      "timeout": 100
    },
    {
      "id": "stop-plan",
      "op": "model.call",
      "user": "真实生命周期验证：stop-plan",
      "tool": "focus_plan",
      "arguments": {
        "agreement": "测试真实预约及截止状态",
        "task_prompt": "仅观察本测试任务，不处理任何日常窗口。",
        "project_dir": {
          "$ref": "project"
        },
        "start_at": {
          "$iso_after": -1
        },
        "end_at": {
          "$iso_after": 45
        },
        "allow_early_finish": true,
        "check_interval_seconds": 10
      },
      "bind": "stop"
    },
    {
      "id": "stops-at-deadline",
      "op": "state.wait",
      "task_id": {
        "$ref": "stop.value.id"
      },
      "status": "not_completed",
      "timeout": 90
    }
  ],
  "present_user": true
}
