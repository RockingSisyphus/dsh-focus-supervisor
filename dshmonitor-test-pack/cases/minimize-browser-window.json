{
  "schemaVersion": 1,
  "id": "minimize-browser-window",
  "title": "通过标签证据最小化真实浏览器窗口",
  "engine": "dsh",
  "platforms": [
    "linux",
    "windows"
  ],
  "group": "regular",
  "verification": "product",
  "timeout": 360,
  "features": [
    "heartbeat",
    "actions",
    "test-reporting"
  ],
  "steps": [
    {
      "id": "workspace",
      "op": "ui.workspace"
    },
    {
      "id": "fixture",
      "op": "fixture.browser",
      "entity": "target",
      "separate_instance": true,
      "html": "<title>Same tab title</title><input id=\"input\"><p>Dedicated close target</p>"
    },
    {
      "id": "sibling",
      "op": "fixture.browser",
      "entity": "sibling",
      "instance": "target",
      "new_window": false,
      "window": "target",
      "html": "<title>Same tab title</title><p>Sibling must survive precise close</p>"
    },
    {
      "id": "heartbeat",
      "op": "heartbeat.enable"
    },
    {
      "id": "plan",
      "op": "model.call",
      "user": "建立真实桌面闭环任务",
      "tool": "focus_plan",
      "arguments": {
        "agreement": "阅读测试文字，分心时提醒",
        "task_prompt": "只验证测试夹具",
        "project_dir": {
          "$ref": "project"
        },
        "start_at": {
          "$iso_after": -1
        },
        "end_at": {
          "$iso_after": 600
        },
        "check_interval_seconds": 6,
        "allow_early_finish": true,
        "deadline_policy": "discuss"
      },
      "bind": "task"
    },
    {
      "id": "task-created",
      "op": "assert",
      "actual": {
        "$ref": "task.value.id"
      },
      "operator": "exists",
      "expected": true
    },
    {
      "id": "activate",
      "op": "fixture.window",
      "entity": "target",
      "action": "activate"
    },
    {
      "id": "report",
      "op": "report.wait",
      "task_id": {
        "$ref": "task.value.id"
      },
      "phase": "monitor",
      "timeout": 70,
      "bind": "report",
      "minimum_samples": 1
    },
    {
      "id": "target",
      "op": "report.target",
      "report_id": {
        "$ref": "report.id"
      },
      "entity": "target",
      "bind": "target",
      "kind": "browser_tab"
    },
    {
      "id": "minimize",
      "op": "model.call",
      "user": "通过真实标签证据最小化所属浏览器窗口",
      "tool": "focus_act",
      "arguments": {
        "task_id": {
          "$ref": "task.value.id"
        },
        "action": "minimize_window",
        "report_id": {
          "$ref": "report.id"
        },
        "target_ref": {
          "$ref": "target.ref"
        }
      },
      "bind": "minimized"
    },
    {
      "id": "min-state",
      "op": "fixture.wait",
      "entity": "target",
      "expected": {
        "window.minimized": true
      },
      "bind": "min_state"
    },
    {
      "id": "min-effect",
      "op": "assert",
      "actual": {
        "$ref": "min_state.matched"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "min-result",
      "op": "assert",
      "actual": {
        "$ref": "minimized.value.minimized"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "force_close",
      "op": "model.call",
      "user": "执行生产动作 force_close",
      "tool": "focus_act",
      "arguments": {
        "task_id": {
          "$ref": "task.value.id"
        },
        "action": "force_close",
        "report_id": {
          "$ref": "report.id"
        },
        "target_ref": {
          "$ref": "target.ref"
        },
        "target_kind": "browser_tab"
      },
      "bind": "action"
    },
    {
      "id": "closed-observe",
      "op": "fixture.wait",
      "entity": "target",
      "expected": {
        "tab_closed": true
      },
      "timeout": 10,
      "bind": "closed"
    },
    {
      "id": "closed-result",
      "op": "assert",
      "actual": {
        "$ref": "action.value.closed"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "closed-assert",
      "op": "assert",
      "actual": {
        "$ref": "closed.matched"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "sibling-observe",
      "op": "fixture.observe",
      "entity": "sibling",
      "bind": "sibling"
    },
    {
      "id": "precise-close",
      "op": "assert",
      "actual": {
        "$ref": "sibling.present"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "scope",
      "op": "assert",
      "actual": {
        "$ref": "action.value.actual_scope"
      },
      "operator": "equals",
      "expected": "browser_tab"
    },
    {
      "id": "finish",
      "op": "model.call",
      "user": "结束测试任务",
      "tool": "focus_finish",
      "arguments": {
        "task_id": {
          "$ref": "task.value.id"
        },
        "verdict": "completed",
        "reason": "结束本轮测试"
      }
    }
  ],
  "visible_browser": true,
  "real_tab_visibility": true,
  "present_user": true
}
