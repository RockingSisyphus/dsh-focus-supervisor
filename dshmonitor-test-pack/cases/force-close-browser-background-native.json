{
  "schemaVersion": 1,
  "id": "force-close-browser-background-native",
  "title": "普通浏览器后台标签精确关闭",
  "engine": "dsh",
  "platforms": [
    "linux",
    "windows"
  ],
  "group": "regular",
  "verification": "product",
  "timeout": 240,
  "features": [
    "heartbeat",
    "actions",
    "test-reporting",
    "tool.focus_act.force_close.browser_tab"
  ],
  "steps": [
    {
      "id": "workspace",
      "op": "ui.workspace"
    },
    {
      "id": "fixture",
      "op": "fixture.browser",
      "entity": "target",
      "native_only": true,
      "title": "Default browser close fixture",
      "html": "<title>Default browser close fixture</title><input><p>Native tab target without debugging port</p>",
      "sibling_title": "Default browser sibling fixture",
      "sibling_html": "<title>Default browser sibling fixture</title><input><p>Sibling must remain open</p>",
      "bind": "fixture"
    },
    {
      "id": "select-target-tab",
      "op": "fixture.select_tab",
      "entity": "target",
      "tab": "target",
      "bind": "selected"
    },
    {
      "id": "target-selected",
      "op": "assert",
      "actual": {
        "$ref": "selected.selected_tab_id"
      },
      "operator": "equals",
      "expected": {
        "$ref": "selected.tab_id"
      }
    },
    {
      "id": "ordinary-launch",
      "op": "assert",
      "actual": {
        "$ref": "fixture.remote_debugging"
      },
      "operator": "equals",
      "expected": false
    },
    {
      "id": "heartbeat",
      "op": "heartbeat.enable"
    },
    {
      "id": "plan",
      "op": "model.call",
      "user": "建立真实桌面闭环任务",
      "tool": "focus_plan",
      "arguments": {
        "agreement": "阅读测试文字，分心时提醒",
        "task_prompt": "只验证测试夹具",
        "project_dir": {
          "$ref": "project"
        },
        "start_at": {
          "$iso_after": -1
        },
        "end_at": {
          "$iso_after": 600
        },
        "check_interval_seconds": 6,
        "allow_early_finish": true
      },
      "bind": "task"
    },
    {
      "id": "task-created",
      "op": "assert",
      "actual": {
        "$ref": "task.value.id"
      },
      "operator": "exists",
      "expected": true
    },
    {
      "id": "activate",
      "op": "fixture.window",
      "entity": "target",
      "action": "activate"
    },
    {
      "id": "report",
      "op": "report.wait",
      "task_id": {
        "$ref": "task.value.id"
      },
      "phase": "monitor",
      "timeout": 70,
      "bind": "report",
      "minimum_samples": 1
    },
    {
      "id": "target",
      "op": "report.target",
      "report_id": {
        "$ref": "report.id"
      },
      "entity": "target",
      "bind": "target",
      "kind": "browser_tab"
    },
    {
      "id": "native-identity",
      "op": "assert",
      "actual": {
        "$ref": "target.evidence.native_tab"
      },
      "operator": "exists",
      "expected": true
    },
    {
      "id": "select-sibling",
      "op": "fixture.select_tab",
      "entity": "target",
      "tab": "sibling",
      "bind": "selection"
    },
    {
      "id": "force_close",
      "op": "model.call",
      "user": "执行生产动作 force_close",
      "tool": "focus_act",
      "arguments": {
        "task_id": {
          "$ref": "task.value.id"
        },
        "action": "force_close",
        "report_id": {
          "$ref": "report.id"
        },
        "target_ref": {
          "$ref": "target.ref"
        },
        "target_kind": "browser_tab"
      },
      "bind": "action"
    },
    {
      "id": "closed-observe",
      "op": "fixture.wait",
      "entity": "target",
      "expected": {
        "present": true,
        "tab_closed": true,
        "sibling_present": true,
        "tabs_observed": true
      },
      "timeout": 10,
      "bind": "closed"
    },
    {
      "id": "closed-result",
      "op": "assert",
      "actual": {
        "$ref": "action.value.closed"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "closed-assert",
      "op": "assert",
      "actual": {
        "$ref": "closed.matched"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "native-exact-scope",
      "op": "assert",
      "actual": {
        "$ref": "action.value.actual_scope"
      },
      "operator": "equals",
      "expected": "browser_tab"
    },
    {
      "id": "finish",
      "op": "model.call",
      "user": "结束测试任务",
      "tool": "focus_finish",
      "arguments": {
        "task_id": {
          "$ref": "task.value.id"
        },
        "verdict": "completed",
        "reason": "结束本轮测试"
      }
    }
  ],
  "present_user": true,
  "note": "目标浏览器没有调试端口；先在真实报告中取得目标标签身份，再建立最小化或后台标签前置状态，经真实 DSH 关闭后独立核对目标消失而同窗口兄弟标签和窗口保留。"
}
