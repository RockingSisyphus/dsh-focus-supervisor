{
  "schemaVersion": 1,
  "id": "windows-upgrade-preservation",
  "title": "现有 Windows 正式安装包升级并保留任务、设置和用户数据",
  "engine": "command",
  "execution": "vm-orchestration",
  "verification": "product",
  "group": "extended",
  "platforms": [
    "windows"
  ],
  "installation": "existing-system",
  "features": [
    "desktop-setup"
  ],
  "timeout": 1500,
  "steps": [
    {
      "id": "prepare",
      "op": "case.run",
      "cases": [
        "upgrade-preserve-prepare"
      ],
      "bind": "before"
    },
    {
      "id": "prepared",
      "op": "assert",
      "actual": {
        "$ref": "before.status"
      },
      "operator": "equals",
      "expected": "passed"
    },
    {
      "id": "checkpoint",
      "op": "vm.checkpoint",
      "bind": "saved"
    },
    {
      "id": "installer",
      "op": "vm.command.start",
      "argv": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        {
          "$ref": "saved.installed_backend_script"
        }
      ]
    },
    {
      "id": "authorize",
      "op": "vm.authorize"
    },
    {
      "id": "installed",
      "op": "vm.command.wait",
      "command": "installer",
      "timeout": 1200,
      "bind": "installer"
    },
    {
      "id": "installer-exit",
      "op": "assert",
      "actual": {
        "$ref": "installer.code"
      },
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "load-upgraded-service",
      "op": "vm.reboot",
      "bind": "boot"
    },
    {
      "id": "observe-restored-service",
      "op": "vm.observe_service",
      "task_id": {
        "$ref": "saved.task.value.id"
      },
      "sampled_after": {
        "$ref": "boot.completed_at"
      },
      "timeout": 90,
      "bind": "restored_before_dsh"
    },
    {
      "id": "use-installed-plugin",
      "op": "case.run",
      "cases": [
        "upgrade-preserve-resume"
      ],
      "bind": "use"
    },
    {
      "id": "normal-use-passed",
      "op": "assert",
      "actual": {
        "$ref": "use.status"
      },
      "operator": "equals",
      "expected": "passed"
    }
  ],
  "persistent_session": true
}
