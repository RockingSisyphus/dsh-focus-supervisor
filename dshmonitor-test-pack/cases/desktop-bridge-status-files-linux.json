{
  "schemaVersion": 1,
  "id": "desktop-bridge-status-files-linux",
  "title": "无任务、预约、离席时状态文件不周期写入",
  "engine": "command",
  "execution": "vm-orchestration",
  "verification": "product",
  "group": "manual",
  "platforms": [
    "linux"
  ],
  "installation": "existing-system",
  "features": [
    "desktop-setup",
    "evidence"
  ],
  "timeout": 6000,
  "steps": [
    {
      "id": "installer",
      "op": "vm.command.run",
      "argv": [
        "sudo",
        "bash",
        "deploy/upgrade-chat.sh",
        "tester"
      ],
      "prepare": true,
      "bind": "installer"
    },
    {
      "id": "installer-exit",
      "op": "assert",
      "actual": {
        "$ref": "installer.code"
      },
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "reload-desktop",
      "op": "vm.reboot"
    },
    {
      "id": "use-installed-plugin",
      "op": "case.run",
      "cases": [
        "desktop-idle-lifecycle",
        "desktop-standby-lifecycle",
        "desktop-bridge-pixels"
      ],
      "bind": "use"
    },
    {
      "id": "normal-use-passed",
      "op": "assert",
      "actual": {
        "$ref": "use.status"
      },
      "operator": "equals",
      "expected": "passed"
    }
  ]
}
