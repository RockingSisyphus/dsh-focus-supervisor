{
  "schemaVersion": 1,
  "id": "ui-task-groups",
  "title": "进行中与已预约任务分组、按开始时间排序与展开收起",
  "engine": "dsh",
  "features": [
    "settings-ui",
    "mascot"
  ],
  "preview": true,
  "timeout": 180,
  "variables": {
    "active_contract": {
      "agreement": "进行中的任务：阅读论文并整理笔记。",
      "task_prompt": "盯住论文阅读窗口。",
      "project_dir": {
        "$ref": "project"
      },
      "start_at": {
        "$iso_after": -1
      },
      "end_at": {
        "$iso_after": 600
      },
      "allow_early_finish": true
    },
    "later_contract": {
      "agreement": "较晚的预约任务：晚上整理实验数据。",
      "task_prompt": "盯住数据处理窗口。",
      "project_dir": {
        "$ref": "project"
      },
      "start_at": {
        "$iso_after": 1800
      },
      "end_at": {
        "$iso_after": 2400
      },
      "allow_early_finish": true
    },
    "earlier_contract": {
      "agreement": "较早的预约任务：下午先写引言。",
      "task_prompt": "盯住写作窗口。",
      "project_dir": {
        "$ref": "project"
      },
      "start_at": {
        "$iso_after": 900
      },
      "end_at": {
        "$iso_after": 1500
      },
      "allow_early_finish": true
    }
  },
  "steps": [
    {
      "id": "workspace",
      "op": "ui.workspace"
    },
    {
      "id": "plan-later",
      "op": "model.call",
      "user": "测试：先登记较晚的预约任务",
      "tool": "focus_plan",
      "arguments": {
        "$ref": "later_contract"
      },
      "bind": "later"
    },
    {
      "id": "plan-earlier",
      "op": "model.call",
      "user": "测试：再登记较早的预约任务",
      "tool": "focus_plan",
      "arguments": {
        "$ref": "earlier_contract"
      },
      "bind": "earlier"
    },
    {
      "id": "plan-active",
      "op": "model.call",
      "user": "测试：登记一个立即开始的任务",
      "tool": "focus_plan",
      "arguments": {
        "$ref": "active_contract"
      },
      "bind": "active"
    },
    {
      "id": "open-panel",
      "op": "ui.open",
      "bind": "panel"
    },
    {
      "id": "panel-shows-three-tasks",
      "op": "ui.wait_tasks",
      "count": 3,
      "timeout": 40,
      "bind": "panel"
    },
    {
      "id": "active-group-has-one",
      "op": "assert",
      "actual": {
        "$ref": "panel.task_groups.active"
      },
      "operator": "count",
      "expected": 1
    },
    {
      "id": "active-task-is-the-immediate-one",
      "op": "assert",
      "actual": {
        "$ref": "panel.task_groups.active.0.id"
      },
      "operator": "equals",
      "expected": {
        "$ref": "active.value.id"
      }
    },
    {
      "id": "active-task-expanded-by-default",
      "op": "assert",
      "actual": {
        "$ref": "panel.task_groups.active.0.expanded"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "scheduled-group-sorted-by-start",
      "op": "assert",
      "actual": {
        "$ref": "panel.task_groups.scheduled.0.id"
      },
      "operator": "equals",
      "expected": {
        "$ref": "earlier.value.id"
      }
    },
    {
      "id": "scheduled-group-second-is-later-registered-later-start",
      "op": "assert",
      "actual": {
        "$ref": "panel.task_groups.scheduled.1.id"
      },
      "operator": "equals",
      "expected": {
        "$ref": "later.value.id"
      }
    },
    {
      "id": "scheduled-collapsed-by-default",
      "op": "assert",
      "actual": {
        "$ref": "panel.task_groups.scheduled.0.expanded"
      },
      "operator": "equals",
      "expected": false
    },
    {
      "id": "toggle-scheduled",
      "op": "ui.toggle_task",
      "task_id": {
        "$ref": "earlier.value.id"
      },
      "bind": "toggled"
    },
    {
      "id": "scheduled-now-expanded",
      "op": "assert",
      "actual": {
        "$ref": "toggled.task_groups.scheduled.0.expanded"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "active-untouched-by-toggle",
      "op": "assert",
      "actual": {
        "$ref": "toggled.task_groups.active.0.expanded"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "toggle-active-collapse",
      "op": "ui.toggle_task",
      "task_id": {
        "$ref": "active.value.id"
      },
      "bind": "collapsed"
    },
    {
      "id": "active-now-collapsed",
      "op": "assert",
      "actual": {
        "$ref": "collapsed.task_groups.active.0.expanded"
      },
      "operator": "equals",
      "expected": false
    },
    {
      "id": "close",
      "op": "ui.close"
    },
    {
      "id": "finish-active",
      "op": "model.call",
      "user": "测试：结束立即开始的任务",
      "tool": "focus_finish",
      "arguments": {
        "task_id": {
          "$ref": "active.value.id"
        },
        "verdict": "cancelled",
        "reason": "分组展示测试结束"
      }
    },
    {
      "id": "finish-earlier",
      "op": "model.call",
      "user": "测试：取消较早的预约任务",
      "tool": "focus_finish",
      "arguments": {
        "task_id": {
          "$ref": "earlier.value.id"
        },
        "verdict": "cancelled",
        "reason": "分组展示测试结束"
      }
    },
    {
      "id": "finish-later",
      "op": "model.call",
      "user": "测试：取消较晚的预约任务",
      "tool": "focus_finish",
      "arguments": {
        "task_id": {
          "$ref": "later.value.id"
        },
        "verdict": "cancelled",
        "reason": "分组展示测试结束"
      }
    }
  ],
  "group": "regular",
  "platforms": [
    "linux",
    "windows"
  ],
  "verification": "product"
}
