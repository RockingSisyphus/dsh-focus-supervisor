{
  "schemaVersion": 1,
  "engine": "dsh",
  "platforms": [
    "linux",
    "windows"
  ],
  "verification": "product",
  "group": "manual",
  "features": [
    "persistence",
    "heartbeat"
  ],
  "timeout": 300,
  "present_user": true,
  "id": "fresh-install-resume",
  "title": "新机重启恢复原任务及已安装浏览器采集通道",
  "steps": [
    {
      "id": "load",
      "op": "session.load"
    },
    {
      "id": "heartbeat",
      "op": "heartbeat.enable"
    },
    {
      "id": "observer-page",
      "op": "fixture.browser",
      "entity": "installation-article",
      "html": "<title>Install browser observer</title><h1>OBSERVER_AFTER_REBOOT_271828</h1><label>Install control<input value=\"INSTALL_VALUE_314159\"></label>"
    },
    {
      "id": "observer-layout",
      "op": "fixture.window",
      "entity": "installation-article",
      "action": "layout",
      "rect": [
        30,
        400,
        760,
        320
      ]
    },
    {
      "id": "keep-browser-extension",
      "op": "native.dialog",
      "title": "Turn off extensions in developer mode",
      "button": "Not now",
      "optional": true,
      "timeout": 5,
      "menu_item": "Remind in 2 weeks"
    },
    {
      "id": "observer-visible",
      "op": "fixture.window",
      "entity": "installation-article",
      "action": "activate"
    },
    {
      "id": "same-task",
      "op": "state.wait",
      "task_id": {
        "$ref": "task.value.id"
      },
      "status": "active",
      "bind": "restored"
    },
    {
      "id": "same-session",
      "op": "assert",
      "actual": {
        "$ref": "restored.session_id"
      },
      "operator": "equals",
      "expected": {
        "$ref": "task.value.session_id"
      }
    },
    {
      "id": "new-report",
      "op": "report.wait",
      "task_id": {
        "$ref": "task.value.id"
      },
      "exclude": [
        {
          "$ref": "before_report.id"
        }
      ],
      "bind": "after_report",
      "timeout": 120,
      "created_after": {
        "$ref": "scenario_started_at"
      },
      "phase": "monitor",
      "sampled_from_after": {
        "$time_after": 0
      }
    },
    {
      "id": "new-real-sampling",
      "op": "assert",
      "actual": {
        "$ref": "after_report.raw.real_end"
      },
      "operator": "gt",
      "expected": {
        "$ref": "scenario_started_at"
      }
    },
    {
      "id": "desktop-restored",
      "op": "assert",
      "actual": {
        "$ref": "after_report.raw.current_desktop_available"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "actual-model-input",
      "op": "model.notice",
      "text": {
        "$ref": "after_report.id"
      }
    },
    {
      "id": "new-report-id",
      "op": "assert",
      "actual": {
        "$ref": "after_report.id"
      },
      "operator": "not_equals",
      "expected": {
        "$ref": "before_report.id"
      }
    },
    {
      "id": "actual-tool-return",
      "op": "model.tool_result",
      "tool": "focus_observe",
      "arguments": {
        "report_id": {
          "$ref": "after_report.id"
        }
      }
    },
    {
      "id": "observer-material",
      "op": "evidence.inspect",
      "report_id": {
        "$ref": "after_report.id"
      },
      "bind": "observer_material"
    },
    {
      "id": "sample-diagnostics",
      "op": "sample.inspect",
      "task_id": {
        "$ref": "task.value.id"
      },
      "bind": "samples"
    },
    {
      "id": "browser-body-delivered",
      "op": "assert",
      "actual": {
        "$ref": "observer_material.browser_semantic_text"
      },
      "operator": "contains",
      "expected": "OBSERVER_AFTER_REBOOT_271828"
    },
    {
      "id": "read-browser-file",
      "op": "model.call",
      "user": "读取本轮安装验收浏览器证据",
      "tool": "read",
      "arguments": {
        "file_path": {
          "$concat": [
            {
              "$ref": "observer_material.folder"
            },
            "/browser-snapshots.json"
          ]
        }
      },
      "bind": "observer_file"
    },
    {
      "id": "browser-file-readable",
      "op": "assert",
      "actual": {
        "$ref": "observer_file.raw"
      },
      "operator": "contains",
      "expected": "OBSERVER_AFTER_REBOOT_271828"
    }
  ]
}
