{
  "schemaVersion": 1,
  "engine": "dsh",
  "verification": "product",
  "verification_layer": "dsh",
  "platforms": [
    "linux",
    "windows"
  ],
  "features": [
    "settings-ui",
    "evidence",
    "heartbeat"
  ],
  "id": "sampling-settings-resume",
  "title": "同任务同profile重启后保留采集设置并实际采样",
  "group": "manual",
  "present_user": true,
  "timeout": 240,
  "steps": [
    {
      "id": "load",
      "op": "session.load"
    },
    {
      "id": "heartbeat",
      "op": "heartbeat.enable"
    },
    {
      "id": "state",
      "op": "state.read",
      "task_id": {
        "$ref": "task.value.id"
      },
      "bind": "resumed"
    },
    {
      "id": "same-task",
      "op": "assert",
      "actual": {
        "$ref": "resumed.live.0.id"
      },
      "operator": "equals",
      "expected": {
        "$ref": "task.value.id"
      }
    },
    {
      "id": "interval-persists",
      "op": "assert",
      "actual": {
        "$ref": "resumed.settings.sampling.interval_seconds"
      },
      "operator": "equals",
      "expected": 6
    },
    {
      "id": "image-limit-persists",
      "op": "assert",
      "actual": {
        "$ref": "resumed.settings.sampling.image_width"
      },
      "operator": "equals",
      "expected": 240
    },
    {
      "id": "page-persists",
      "op": "assert",
      "actual": {
        "$ref": "resumed.settings.reporting.text_page_chars"
      },
      "operator": "equals",
      "expected": 73
    },
    {
      "id": "create-native-fixture",
      "op": "fixture.app",
      "entity": "legacy-app",
      "windows": [
        {
          "title": "FocusTest GTK same title",
          "rect": [
            30,
            40,
            440,
            320
          ],
          "controls": [
            {
              "type": "label",
              "text": "ALPHA_REAL_ATSPI_314159\n真实界面文字：正在核验通用无障碍采集。"
            },
            {
              "type": "edit",
              "text": "VISIBLE_EDITED_VALUE_0"
            },
            {
              "type": "password",
              "text": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
            }
          ],
          "id": "legacy-0"
        },
        {
          "title": "FocusTest GTK same title",
          "rect": [
            510,
            40,
            440,
            320
          ],
          "controls": [
            {
              "type": "label",
              "text": "BETA_REAL_ATSPI_271828\n真实界面文字：正在核验通用无障碍采集。"
            },
            {
              "type": "edit",
              "text": "VISIBLE_EDITED_VALUE_1"
            },
            {
              "type": "password",
              "text": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
            }
          ],
          "id": "legacy-1"
        }
      ],
      "log_text": "_TAIL_SETTINGS_314159"
    },
    {
      "id": "show",
      "op": "fixture.window",
      "entity": "legacy-1",
      "action": "activate"
    },
    {
      "id": "actual-report",
      "op": "report.wait",
      "task_id": {
        "$ref": "task.value.id"
      },
      "minimum_samples": 2,
      "sampled_from_after": {
        "$time_after": 0
      },
      "bind": "report"
    },
    {
      "id": "desktop-available",
      "op": "assert",
      "actual": {
        "$ref": "report.raw.current_desktop_available"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "new-effective-settings",
      "op": "assert",
      "actual": {
        "$ref": "report.raw.settings_timeline.0.settings.sampling.interval_seconds"
      },
      "operator": "equals",
      "expected": 6
    },
    {
      "id": "model-received",
      "op": "model.notice",
      "text": {
        "$ref": "report.id"
      }
    }
  ]
}
