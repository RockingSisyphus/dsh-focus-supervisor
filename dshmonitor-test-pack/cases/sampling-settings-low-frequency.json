{
  "schemaVersion": 1,
  "engine": "dsh",
  "verification": "product",
  "verification_layer": "dsh",
  "group": "extended",
  "platforms": [
    "linux",
    "windows"
  ],
  "features": [
    "settings-ui",
    "evidence",
    "heartbeat"
  ],
  "timeout": 180,
  "id": "sampling-settings-low-frequency",
  "title": "低频图片仍保留真实时间与有效状态",
  "variables": {
    "contract": {
      "agreement": "读懂专用测试窗口里的论文文字。",
      "task_prompt": "TASK_EXTRA_314159",
      "project_dir": {
        "$ref": "project"
      },
      "start_at": {
        "$iso_after": 180
      },
      "end_at": {
        "$iso_after": 900
      },
      "allow_early_finish": true
    }
  },
  "present_user": true,
  "steps": [
    {
      "id": "save",
      "op": "ui.settings",
      "values": {
        "sampling": {
          "interval_seconds": 6,
          "screenshot_interval_seconds": 30,
          "native_screenshot_interval_seconds": 30,
          "image_width": 240,
          "image_height": 200,
          "screen_width": 960,
          "screen_height": 600,
          "text_interval_seconds": 30,
          "text_chars": 700,
          "text_nodes": 70,
          "browser_interval_seconds": 6,
          "browser_chars": 600,
          "browser_pages": 2,
          "log_interval_seconds": 30,
          "log_bytes": 500
        },
        "reporting": {
          "preview_chars": 90,
          "text_page_chars": 100,
          "overview_chars": 120
        }
      },
      "save": true
    },
    {
      "id": "close",
      "op": "ui.close"
    },
    {
      "id": "workspace",
      "op": "ui.workspace"
    },
    {
      "id": "heartbeat",
      "op": "heartbeat.enable"
    },
    {
      "id": "plan-active",
      "op": "model.call",
      "user": "测试：plan-active",
      "tool": "focus_plan",
      "arguments": {
        "$merge": [
          {
            "$ref": "contract"
          },
          {
            "start_at": {
              "$iso_after": -1
            },
            "check_interval_seconds": 6
          }
        ]
      },
      "bind": "task"
    },
    {
      "id": "create-native-fixture",
      "op": "fixture.app",
      "entity": "legacy-app",
      "windows": [
        {
          "title": "FocusTest GTK same title",
          "rect": [
            30,
            40,
            440,
            320
          ],
          "controls": [
            {
              "type": "label",
              "text": "ALPHA_REAL_ATSPI_314159\n真实界面文字：正在核验通用无障碍采集。"
            },
            {
              "type": "edit",
              "text": "VISIBLE_EDITED_VALUE_0"
            },
            {
              "type": "password",
              "text": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
            }
          ],
          "id": "legacy-0"
        },
        {
          "title": "FocusTest GTK same title",
          "rect": [
            510,
            40,
            440,
            320
          ],
          "controls": [
            {
              "type": "label",
              "text": "BETA_REAL_ATSPI_271828\n真实界面文字：正在核验通用无障碍采集。"
            },
            {
              "type": "edit",
              "text": "VISIBLE_EDITED_VALUE_1"
            },
            {
              "type": "password",
              "text": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
            }
          ],
          "id": "legacy-1"
        }
      ],
      "log_text": "_TAIL_SETTINGS_314159"
    },
    {
      "id": "show",
      "op": "fixture.window",
      "entity": "legacy-1",
      "action": "activate"
    },
    {
      "id": "observe",
      "op": "fixture.watch_input",
      "entity": "legacy-1",
      "seconds": 52,
      "chunks": []
    },
    {
      "id": "low-frequency-samples",
      "op": "sample.inspect",
      "task_id": {
        "$ref": "task.value.id"
      },
      "entity": "legacy-1",
      "bind": "slow"
    },
    {
      "id": "old-threshold-crossed",
      "op": "assert",
      "actual": {
        "$ref": "slow.metrics.max_image_age"
      },
      "operator": "gt",
      "expected": 15
    },
    {
      "id": "real-images-retained",
      "op": "assert",
      "actual": {
        "$ref": "slow.metrics.image_count"
      },
      "operator": "gt",
      "expected": 3
    },
    {
      "id": "report",
      "op": "report.wait",
      "task_id": {
        "$ref": "task.value.id"
      },
      "minimum_samples": 2,
      "sampled_from_after": {
        "$time_after": -15
      },
      "bind": "report"
    },
    {
      "id": "no-false-gap",
      "op": "assert",
      "actual": {
        "$ref": "report.raw.unobserved_gap_seconds"
      },
      "operator": "equals",
      "expected": 0
    }
  ]
}
