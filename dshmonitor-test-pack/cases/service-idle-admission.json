{
  "schemaVersion": 1,
  "id": "service-idle-admission",
  "title": "正式服务空闲退出前后通过 DSH 创建任务",
  "engine": "dsh",
  "features": [
    "persistence",
    "task-admission"
  ],
  "platforms": [
    "linux",
    "windows"
  ],
  "group": "extended",
  "verification": "product",
  "verification_layer": "dsh",
  "timeout": 300,
  "steps": [
    {
      "id": "workspace",
      "op": "ui.workspace"
    },
    {
      "id": "idle-1",
      "op": "service.observe",
      "seconds": 15,
      "bind": "idle1"
    },
    {
      "id": "plan-1",
      "op": "model.call",
      "user": "生命周期测试第1轮：预约一小时后的阅读任务。",
      "tool": "focus_plan",
      "arguments": {
        "agreement": "读懂专用测试窗口里的论文文字。",
        "task_prompt": "TASK_EXTRA_314159",
        "project_dir": {
          "$ref": "project"
        },
        "start_at": {
          "$iso_after": 3600
        },
        "end_at": {
          "$iso_after": 7200
        },
        "allow_early_finish": true,
        "deadline_policy": "discuss"
      },
      "bind": "task1"
    },
    {
      "id": "accepted-1",
      "op": "assert",
      "actual": {
        "$ref": "task1.value.status"
      },
      "operator": "equals",
      "expected": "scheduled"
    },
    {
      "id": "finish-1",
      "op": "model.call",
      "user": "生命周期测试第1轮：取消刚才的预约。",
      "tool": "focus_finish",
      "arguments": {
        "task_id": {
          "$ref": "task1.value.id"
        },
        "verdict": "cancelled",
        "reason": "本轮预约验证结束"
      },
      "bind": "finish1"
    },
    {
      "id": "finished-1",
      "op": "assert",
      "actual": {
        "$ref": "finish1.value.status"
      },
      "operator": "equals",
      "expected": "cancelled"
    },
    {
      "id": "idle-2",
      "op": "service.observe",
      "seconds": 9.5,
      "bind": "idle2"
