{
  "schemaVersion": 1,
  "id": "native-window-group",
  "title": "同进程歧义窗口组：两窗正文及允许隐藏成员",
  "variables": {
    "contract": {
      "agreement": "读懂专用测试窗口里的论文文字。",
      "task_prompt": "TASK_EXTRA_314159",
      "project_dir": {
        "$ref": "project"
      },
      "start_at": {
        "$iso_after": 180
      },
      "end_at": {
        "$iso_after": 900
      },
      "allow_early_finish": true
    }
  },
  "engine": "dsh",
  "platforms": [
    "linux"
  ],
  "group": "extended",
  "verification": "product",
  "features": [
    "evidence",
    "sampling-settings"
  ],
  "steps": [
    {
      "id": "group-settings",
      "op": "ui.settings",
      "values": {
        "sampling": {
          "text_interval_seconds": 2,
          "text_chars": 12000,
          "text_nodes": 1600
        }
      },
      "save": true
    },
    {
      "id": "close",
      "op": "ui.close"
    },
    {
      "id": "workspace",
      "op": "ui.workspace"
    },
    {
      "id": "heartbeat",
      "op": "heartbeat.enable"
    },
    {
      "id": "plan-active",
      "op": "model.call",
      "user": "测试：plan-active",
      "tool": "focus_plan",
      "arguments": {
        "$merge": [
          {
            "$ref": "contract"
          },
          {
            "start_at": {
              "$iso_after": -1
            },
            "check_interval_seconds": 6
          }
        ]
      },
      "bind": "task"
    },
    {
      "id": "create-native-fixture",
      "op": "fixture.app",
      "entity": "legacy-app",
      "windows": [
        {
          "title": "FocusTest GTK same title",
          "rect": [
            30,
            40,
            440,
            320
          ],
          "controls": [
            {
              "type": "label",
              "text": "ALPHA_REAL_ATSPI_314159\n真实界面文字：正在核验通用无障碍采集。"
            },
            {
              "type": "edit",
              "text": "VISIBLE_EDITED_VALUE_0"
            },
            {
              "type": "password",
              "text": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
            }
          ],
          "id": "legacy-0"
        },
        {
          "title": "FocusTest GTK same title",
          "rect": [
            510,
            40,
            440,
            320
          ],
          "controls": [
            {
              "type": "label",
              "text": "BETA_REAL_ATSPI_271828\n真实界面文字：正在核验通用无障碍采集。"
            },
            {
              "type": "edit",
              "text": "VISIBLE_EDITED_VALUE_1"
            },
            {
              "type": "password",
              "text": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
            }
          ],
          "id": "legacy-1"
        }
      ],
      "log_text": "_TAIL_SETTINGS_314159"
    },
    {
      "id": "show",
      "op": "fixture.window",
      "entity": "legacy-1",
      "action": "activate"
    },
    {
      "id": "both-wait",
      "op": "fixture.watch_input",
      "entity": "legacy-0",
      "seconds": 12,
      "chunks": []
    },
    {
      "id": "both-read",
      "op": "sample.inspect",
      "task_id": {
        "$ref": "task.value.id"
      },
      "entity": "legacy-0",
      "after": {
        "$time_after": -6
      },
      "bind": "both"
    },
    {
      "id": "both-content-0",
      "op": "assert",
      "actual": {
        "$ref": "both.frames"
      },
      "operator": "contains",
      "expected": "ALPHA_REAL_ATSPI_314159"
    },
    {
      "id": "both-content-1",
      "op": "assert",
      "actual": {
        "$ref": "both.frames"
      },
      "operator": "contains",
      "expected": "BETA_REAL_ATSPI_271828"
    },
    {
      "id": "both-content-2",
      "op": "assert",
      "actual": {
        "$ref": "both.frames"
      },
      "operator": "contains",
      "expected": "process_window_group"
    },
    {
      "id": "both-content-3",
      "op": "assert",
      "actual": {
        "$ref": "both.frames"
      },
      "operator": "contains",
      "expected": "请结合截图判断归属"
    },
    {
      "id": "hide-right",
      "op": "fixture.window",
      "entity": "legacy-1",
      "action": "minimize"
    },
    {
      "id": "one-hidden-wait",
      "op": "fixture.watch_input",
      "entity": "legacy-0",
      "seconds": 12,
      "chunks": []
    },
    {
      "id": "one-hidden-read",
      "op": "sample.inspect",
      "task_id": {
        "$ref": "task.value.id"
      },
      "entity": "legacy-0",
      "after": {
        "$time_after": -6
      },
      "bind": "one-hidden"
    },
    {
      "id": "one-hidden-content-0",
      "op": "assert",
      "actual": {
        "$ref": "one-hidden.frames"
      },
      "operator": "contains",
      "expected": "ALPHA_REAL_ATSPI_314159"
    },
    {
      "id": "one-hidden-content-1",
      "op": "assert",
      "actual": {
        "$ref": "one-hidden.frames"
      },
      "operator": "contains",
      "expected": "BETA_REAL_ATSPI_271828"
    },
    {
      "id": "one-hidden-content-2",
      "op": "assert",
      "actual": {
        "$ref": "one-hidden.frames"
      },
      "operator": "contains",
      "expected": "process_window_group"
    },
    {
      "id": "one-hidden-content-3",
      "op": "assert",
      "actual": {
        "$ref": "one-hidden.frames"
      },
      "operator": "contains",
      "expected": "请结合截图判断归属"
    },
    {
      "id": "finish",
      "op": "model.call",
      "user": "测试：finish",
      "tool": "focus_finish",
      "arguments": {
        "task_id": {
          "$ref": "task.value.id"
        },
        "verdict": "completed",
        "reason": "固定回复只验证软件验收流程。"
      },
      "bind": "result"
    }
  ],
  "timeout": 240,
  "browser_skill": false,
  "present_user": true
}
