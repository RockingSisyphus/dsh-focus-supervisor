{
  "schemaVersion": 1,
  "id": "debug-evidence-retention",
  "title": "真实设置打开调试保留后，任务结束仍可读原始证据",
  "engine": "dsh",
  "verification": "product",
  "verification_layer": "dsh",
  "group": "extended",
  "platforms": ["linux", "windows"],
  "features": ["settings-ui", "evidence", "heartbeat", "cleanup"],
  "timeout": 240,
  "steps": [
    {"id": "enable-debug", "op": "ui.settings", "values": {"debug_mode": true, "away_heartbeats": 10}, "save": true},
    {"id": "reload", "op": "ui.reload"},
    {"id": "read-setting", "op": "ui.settings", "bind": "setting"},
    {"id": "debug-saved", "op": "assert", "actual": {"$ref": "setting.debug_mode"}, "operator": "equals", "expected": true},
    {"id": "close-settings", "op": "ui.close"},
    {"id": "workspace", "op": "ui.workspace"},
    {"id": "fixture", "op": "fixture.app", "entity": "editor", "windows": [
      {"id": "target", "title": "调试保留真实窗口", "rect": [50, 100, 500, 340],
       "controls": [{"type": "edit", "text": "DEBUG_RETENTION_VISIBLE_TEXT_20260924"}]}
    ]},
    {"id": "heartbeat", "op": "heartbeat.enable"},
    {"id": "plan", "op": "model.call", "tool": "focus_plan", "user": "创建调试保留验证任务",
     "arguments": {"agreement": "阅读专用测试窗口", "task_prompt": "只检查测试窗口",
                   "project_dir": {"$ref": "project"}, "start_at": {"$iso_after": -1},
                   "end_at": {"$iso_after": 600}, "check_interval_seconds": 12,
                   "allow_early_finish": true}, "bind": "task"},
    {"id": "show-fixture", "op": "fixture.window", "entity": "target", "action": "activate"},
    {"id": "report", "op": "report.wait", "task_id": {"$ref": "task.value.id"},
     "phase": "monitor", "minimum_samples": 2, "timeout": 80, "bind": "report"},
    {"id": "inspect", "op": "evidence.inspect", "report_id": {"$ref": "report.id"},
     "target_title": "调试保留真实窗口", "target_entity": "target", "bind": "material"},
    {"id": "fixture-text", "op": "assert", "actual": {"$ref": "material.evidence"},
     "operator": "contains", "expected": "DEBUG_RETENTION_VISIBLE_TEXT_20260924"},
    {"id": "finish", "op": "model.call", "tool": "focus_finish", "user": "结束调试保留验证任务",
     "arguments": {"task_id": {"$ref": "task.value.id"}, "verdict": "completed",
                   "reason": "验证证据保留"}, "bind": "finished"},
    {"id": "folder-still-present", "op": "file.exists",
     "path": {"$ref": "material.task_folder"}, "bind": "exists"},
    {"id": "folder-retained", "op": "assert", "actual": {"$ref": "exists"},
     "operator": "equals", "expected": true},
    {"id": "read-ended-report", "op": "model.call", "tool": "focus_report",
     "user": "复查已结束任务的报告", "arguments": {"report_id": {"$ref": "report.id"},
     "operation": "get_overview"}, "bind": "retained"},
    {"id": "report-retained", "op": "assert", "actual": {"$ref": "retained.value.report_id"},
     "operator": "equals", "expected": {"$ref": "report.id"}},
    {"id": "raw-samples", "op": "sample.inspect", "task_id": {"$ref": "task.value.id"},
     "entity": "target", "bind": "raw_samples"},
    {"id": "raw-samples-retained", "op": "assert", "actual": {"$ref": "raw_samples.count"},
     "operator": "gt", "expected": 1},
    {"id": "restore-settings", "op": "ui.settings", "values": {
      "debug_mode": {"$ref": "initial_settings.debug_mode"},
      "away_heartbeats": {"$ref": "initial_settings.away_heartbeats"}
    }, "save": true}
  ]
}
