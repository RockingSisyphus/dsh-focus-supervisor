{
  "schemaVersion": 1,
  "id": "native-combined",
  "title": "综合原生场景：四窗口、结构/日志/截图、任务生命周期与真实关闭",
  "engine": "command",
  "features": [
    "application-capture",
    "scheduling",
    "prompt-permissions",
    "heartbeat",
    "evidence",
    "actions",
    "cleanup"
  ],
  "argv": [
    "$python",
    "dshmonitor-test-pack/runtime/native_combined.py",
    "--output",
    "$output",
    "--case",
    "$case"
  ],
  "expect_exit": 0,
  "timeout": 240,
  "variables": {
    "contract": {
      "task_id": "combined",
      "agreement": "观察测试界面并解释内容",
      "task_prompt": "只核查测试窗口的可见文字；组合场景测试",
      "project_dir": {
        "$ref": "project"
      },
      "start_at": {
        "$time_after": 30
      },
      "end_at": {
        "$time_after": 300
      },
      "allow_early_finish": true,
      "check_interval_seconds": 2,
      "strictness": "strict"
    },
    "extension_end": {
      "$time_after": 360
    }
  },
  "steps": [
    {
      "id": "plan",
      "op": "monitor.call",
      "method": "plan",
      "args": [
        {
          "$ref": "contract"
        },
        "test-chat"
      ],
      "bind": "task"
    },
    {
      "id": "scheduled",
      "op": "assert",
      "actual": {
        "$ref": "task.status"
      },
      "operator": "equals",
      "expected": "scheduled"
    },
    {
      "id": "conflicting-plan",
      "op": "monitor.call",
      "method": "plan",
      "args": [
        {
          "$merge": [
            {
              "$ref": "contract"
            },
            {
              "task_id": "conflict"
            }
          ]
        },
        "test-chat"
      ],
      "capture_error": true,
      "bind": "conflict"
    },
    {
      "id": "conflict-identifies-task",
      "op": "assert",
      "actual": {
        "$ref": "conflict.error"
      },
      "operator": "contains",
      "expected": "combined"
    },
    {
      "id": "locked-configure",
      "op": "monitor.call",
      "method": "configure",
      "args": [
        {
          "patch": {
            "mascot_size": 120
          }
        },
        "ui"
      ],
      "capture_error": true,
      "bind": "locked"
    },
    {
      "id": "scheduled-settings-locked",
      "op": "assert",
      "actual": {
        "$ref": "locked.error"
      },
      "operator": "exists",
      "expected": true
    },
    {
      "id": "begin",
      "op": "monitor.call",
      "method": "revise",
      "args": [
        {
          "$merge": [
            {
              "$ref": "contract"
            },
            {
              "start_at": {
                "$time_after": -1
              },
              "reason": "测试开始"
            }
          ]
        },
        "test-chat"
      ],
      "bind": "task"
    },
    {
      "id": "active",
      "op": "assert",
      "actual": {
        "$ref": "task.status"
      },
      "operator": "equals",
      "expected": "active"
    },
