{
  "schemaVersion": 1,
  "id": "browser-read-focus",
  "title": "后台浏览器取证不应抢走原生应用焦点",
  "engine": "dsh",
  "features": [
    "heartbeat",
    "desktop-gnome",
    "evidence",
    "native-tools",
    "actions",
    "cleanup"
  ],
  "variables": {
    "contract": {
      "agreement": "读懂专用测试窗口里的论文文字。",
      "task_prompt": "TASK_EXTRA_314159",
      "project_dir": {
        "$ref": "project"
      },
      "start_at": {
        "$iso_after": 180
      },
      "end_at": {
        "$iso_after": 900
      },
      "allow_early_finish": true
    }
  },
  "steps": [
    {
      "id": "custom-prompts",
      "op": "ui.settings",
      "values": {
        "instructions": "GLOBAL_INSTRUCTIONS_271828",
        "heartbeat_prompt": "GLOBAL_HEARTBEAT_161803"
      },
      "save": true
    },
    {
      "id": "close",
      "op": "ui.close"
    },
    {
      "id": "choose-workspace",
      "op": "ui.workspace"
    },
    {
      "id": "heartbeat-model",
      "op": "heartbeat.enable"
    },
    {
      "id": "bind-dsh-browser",
      "op": "fixture.page",
      "entity": "dsh-browser"
    },
    {
      "id": "browser-before",
      "op": "desktop.snapshot",
      "entity": "dsh-browser",
      "bind": "before_browser"
    },
    {
      "id": "plan-active",
      "op": "model.call",
      "user": "测试：plan-active",
      "tool": "focus_plan",
      "arguments": {
        "$merge": [
          {
            "$ref": "contract"
          },
          {
            "start_at": {
              "$iso_after": -1
            },
            "check_interval_seconds": 6
          }
        ]
      },
      "bind": "task"
    },
    {
      "id": "create-native-fixture",
      "op": "fixture.app",
      "entity": "legacy-app",
      "windows": [
        {
          "title": "FocusTest GTK same title",
          "rect": [
            30,
            40,
            440,
            320
          ],
          "controls": [
            {
              "type": "label",
              "text": "ALPHA_REAL_ATSPI_314159\n真实界面文字：正在核验通用无障碍采集。"
            },
            {
              "type": "edit",
              "text": "VISIBLE_EDITED_VALUE_0"
            },
            {
              "type": "password",
              "text": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
            }
          ],
          "id": "legacy-0"
        },
        {
          "title": "FocusTest GTK same title",
          "rect": [
            510,
            40,
            440,
            320
          ],
          "controls": [
            {
              "type": "label",
              "text": "BETA_REAL_ATSPI_271828\n真实界面文字：正在核验通用无障碍采集。"
            },
            {
              "type": "edit",
              "text": "VISIBLE_EDITED_VALUE_1"
            },
            {
              "type": "password",
              "text": "TEST_PASSWORD_MUST_NOT_LEAK_98765"
            }
          ],
          "id": "legacy-1"
        }
      ]
    },
    {
      "id": "show-left-native",
      "op": "fixture.interact",
      "entity": "legacy-0",
      "action": "focus"
    },
    {
      "id": "show-right-native",
      "op": "fixture.interact",
      "entity": "legacy-1",
      "action": "focus"
    },
    {
      "id": "native-identities",
      "op": "native.accessibility_inventory",
      "bind": "nativeIdentities"
    },
    {
      "id": "observe-focus",
      "op": "fixture.watch_input",
      "entity": "legacy-1",
      "seconds": 30,
      "chunks": [],
      "bind": "focus_watch"
    },
    {
      "id": "browser-after",
      "op": "desktop.snapshot",
      "entity": "dsh-browser",
      "bind": "after_browser"
    },
    {
      "id": "actual-browser-windows",
      "op": "fixture.browser_inventory",
      "bind": "browser_inventory"
    },
    {
      "id": "no-extra-browser-window",
      "op": "assert",
      "actual": {
        "$ref": "browser_inventory.window_count"
      },
      "operator": "equals",
      "expected": 1
    },
    {
      "id": "focus-retained",
      "op": "assert",
      "actual": {
        "$ref": "focus_watch.focus_retained"
      },
      "operator": "equals",
      "expected": true
    },
    {
      "id": "finish",
      "op": "model.call",
      "user": "测试：finish",
      "tool": "focus_finish",
      "arguments": {
        "task_id": {
          "$ref": "task.value.id"
        },
        "verdict": "completed",
        "reason": "固定回复只验证软件验收流程。"
      },
      "bind": "result"
    }
  ],
  "group": "extended",
  "platforms": [
    "linux",
    "windows"
  ],
  "verification": "product",
  "note": "正式后台按真实时间生成报告；时长覆盖算法仅由契约测试覆盖。",
  "present_user": true,
  "timeout": 180
}
