{
  "schemaVersion": 1,
  "id": "fresh-register-only",
  "title": "新机仅注册正式包并确认后台尚未安装",
  "engine": "dsh",
  "features": [
    "settings-ui",
    "desktop-setup"
  ],
  "preview": true,
  "npm_install": true,
  "timeout": 1200,
  "note": "仅在干净来宾执行；真实 DSH、实际安装按钮和系统授权。系统重新登录由外层 JSON 编排。",
  "steps": [
    {
      "id": "workspace",
      "op": "ui.workspace"
    },
    {
      "id": "panel",
      "op": "ui.open",
      "bind": "panel"
    },
    {
      "id": "card-needs-install",
      "op": "assert",
      "actual": {
        "$ref": "panel.setup_card.state"
      },
      "operator": "equals",
      "expected": "required"
    }
  ],
  "group": "manual",
  "platforms": [
    "linux",
    "windows"
  ],
  "verification": "product",
  "installation": "fresh",
  "verification_layer": "dsh"
}
